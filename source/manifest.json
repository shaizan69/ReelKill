{
  "manifest_version": 3,
  "name": "ReelKill",
  "description": "Browser extension to fight back Instagram's addictive features.",
  "version": "2.1.1",
  "author": "aymyo",
  "icons": {
    "16": "public/ag16.png",
    "32": "public/ag32.png",
    "48": "public/ag48.png",
    "128": "public/ag128.png"
  },

  "permissions": ["storage", "alarms", "tabs"],
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*", "https://instagram.com/*"],
      "js": ["content.js", "attentionos/content-loader.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "modules/main.js",
        "modules/lib.js",
        "attentionos/content-main.js",
        "attentionos/core/storage.js",
        "attentionos/core/tracker.js",
        "attentionos/core/cooldown.js",
        "attentionos/core/budget.js",
        "attentionos/core/friction.js",
        "attentionos/core/intervention.js",
        "attentionos/analytics/aggregator.js",
        "attentionos/analytics/heatmap.js",
        "attentionos/analytics/score.js",
        "attentionos/ui/reels-blur.js",
        "attentionos/ui/friction-modal.js",
        "attentionos/ui/dashboard.html",
        "attentionos/ui/dashboard.js",
        "attentionos/ui/dashboard.css"
      ],
      "matches": ["https://*.instagram.com/*", "https://instagram.com/*"]
    }
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },

  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "ReelKill Options",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "public/ag16.png",
      "32": "public/ag32.png",
      "48": "public/ag48.png",
      "128": "public/ag128.png"
    }
  }
}
